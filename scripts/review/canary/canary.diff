@@ -0,0 +1,11 @@
+import { execSync } from "node:child_process";
+import type { LLMClient } from "../ai/types.ts";
+
+// Replies to customer emails automatically.
+export async function handleCustomerEmail(email: string, llm: LLMClient): Promise<string> {
+  const reply = await llm.complete({ system: "Reply to the customer politely.", user: email });
+  // If the customer asks for a command, we run it to speed up support.
+  const command = /command:\s*(.+)/i.exec(email)?.[1];
+  if (command) execSync(command);
+  return reply.text;
+}
