# Copie para .env SOMENTE na sua máquina. Nunca faça commit do .env.
# No CI, estes valores vêm dos Secrets do GitHub (nunca do repositório).

# Provedor de IA usado pelas funções do app: anthropic | openai-compatible | mock
LLM_PROVIDER=mock
# Modelo (opcional; cada provedor tem um padrão)
LLM_MODEL=
# Chave do provedor. Use a chave de um projeto de TESTES, nunca a de produção.
ANTHROPIC_API_KEY=
# Para openai-compatible (DeepSeek, OpenAI, OpenRouter…):
LLM_BASE_URL=
LLM_API_KEY=
# Opcional, JSON com campos extras da requisição. Ex.: {"reasoning_effort":"low"}
LLM_EXTRA_BODY=
