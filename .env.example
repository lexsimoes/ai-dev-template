# Copy to .env ONLY on your machine. Never commit the .env file.
# In CI, these values come from GitHub Secrets (never from the repository).

# AI provider used by the app functions: anthropic | openai-compatible | mock
LLM_PROVIDER=mock
# Model (optional; each provider has a default)
LLM_MODEL=
# Provider key. Use the key of a TEST project, never the production one.
ANTHROPIC_API_KEY=
# For openai-compatible (DeepSeek, OpenAI, OpenRouter…):
LLM_BASE_URL=
LLM_API_KEY=
# Optional, JSON with extra request fields. E.g. {"reasoning_effort":"low"}
LLM_EXTRA_BODY=
